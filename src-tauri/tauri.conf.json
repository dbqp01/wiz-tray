{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiZ Tray",
  "version": "0.1.0",
  "identifier": "com.wiztray.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WiZ Tray",
        "width": 820,
        "height": 700,
        "minWidth": 420,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "dbqp01",
    "shortDescription": "Controla tu foco WiZ desde la bandeja de Windows",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCNUY2NzkxMUE1M0VGQzgKUldUSTcxTWFrV2RmQzVoY0swaVpiNTVxWHJubkJraVRoMjRPT01MK1JwSEcrdGNYNmZrL0RkenoK",
      "endpoints": [
        "https://github.com/dbqp01/wiz-tray/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
